VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Default/local URLs. Keep production endpoint overrides in
# .env.production.local and development overrides in .env.development.local.
VITE_API_URL=http://localhost:8000
# Used by upgrade CTAs, Settings links and "Open in dashboard" — points at canvasjob-web.
VITE_WEB_URL=http://localhost:3000
# Free-tier tracked-job allowance shown in the account sheet's meter. Mirrors
# the backend and canvasjob-web's NEXT_PUBLIC_FREE_TRACKED_JOB_LIMIT.
VITE_FREE_TRACKED_JOB_LIMIT=20
